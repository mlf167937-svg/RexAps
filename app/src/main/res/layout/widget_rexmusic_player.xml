<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rexw_bg"
    tools:ignore="HardcodedText,ContentDescription">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/rexw_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/rexw_cover_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="RexMusic"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_track_artist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Pilih lagu untuk mulai"
                    android:textColor="#C7FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/rexw_chip"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:text="● ONLINE"
                    android:textColor="#FF78C8FF"
                    android:textSize="8sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_lyrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="♪"
                android:textColor="#FFA99BFF"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_time_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="00:00"
                    android:textColor="#B3FFFFFF"
                    android:textSize="9sp" />

                <ProgressBar
                    android:id="@+id/widget_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="4dp"
                    android:minHeight="4dp"
                    android:progress="0"
                    android:progressDrawable="@drawable/rexw_progress" />

                <TextView
                    android:id="@+id/widget_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="00:00"
                    android:textColor="#B3FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:contentDescription="Lagu sebelumnya"
                android:paddingStart="8dp"
                android:paddingTop="10dp"
                android:paddingEnd="8dp"
                android:paddingBottom="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/rexw_ic_prev" />

            <ImageView
                android:id="@+id/widget_play_pause"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/rexw_btn_play"
                android:contentDescription="Putar"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/rexw_ic_play" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:contentDescription="Lagu berikutnya"
                android:paddingStart="8dp"
                android:paddingTop="10dp"
                android:paddingEnd="8dp"
                android:paddingBottom="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/rexw_ic_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>