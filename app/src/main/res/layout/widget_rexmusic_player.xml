<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rexw_bg"
    tools:ignore="HardcodedText,ContentDescription">

    <!-- 1. Cover besar di KANAN sebagai background -->
    <ImageView
        android:id="@+id/widget_cover_bg"
        android:layout_width="120dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/rexw_cover_placeholder" />

    <!-- Scrim gradient kiri→kanan supaya teks tetap kebaca -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/rexw_scrim" />

    <!-- 3. Tint warna dominan (opsional, tipis saja) -->
    <ImageView
        android:id="@+id/widget_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.18"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/rexw_tint"
        android:tint="#FF5B47E0" />

    <!-- 4. Konten utama -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="5dp"
        android:paddingEnd="4dp"
        android:paddingBottom="5dp">

        <!-- Cover kecil di kiri -->
        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/rexw_cover_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="RexMusic"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

            <!-- Artist + source (status) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_track_artist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Pilih lagu untuk mulai"
                    android:textColor="#B8FFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.05"
                    android:maxLines="1"
                    android:text="● ONLINE"
                    android:textColor="#FF5FBEFF"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- LIRIK KECIL (1 baris) -->
            <TextView
                android:id="@+id/widget_lyrics_small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="♪"
                android:textColor="#99FFFFFF"
                android:textSize="10sp"
                android:textStyle="italic" />

            <!-- Progress + durasi -->
            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:importantForAccessibility="no"
                android:max="1000"
                android:maxHeight="3dp"
                android:minHeight="3dp"
                android:progress="0"
                android:progressDrawable="@drawable/rexw_progress" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_time_current"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="00:00"
                    android:textColor="#99FFFFFF"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="00:00"
                    android:textColor="#99FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Kontrol -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="38dp"
                android:layout_height="44dp"
                android:background="@drawable/rexw_btn_ghost"
                android:contentDescription="Lagu sebelumnya"
                android:paddingLeft="7dp"
                android:paddingTop="10dp"
                android:paddingRight="7dp"
                android:paddingBottom="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/rexw_ic_prev" />

            <ImageView
                android:id="@+id/widget_play_pause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/rexw_btn_play"
                android:contentDescription="Putar"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/rexw_ic_play" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="38dp"
                android:layout_height="44dp"
                android:background="@drawable/rexw_btn_ghost"
                android:contentDescription="Lagu berikutnya"
                android:paddingLeft="7dp"
                android:paddingTop="10dp"
                android:paddingRight="7dp"
                android:paddingBottom="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/rexw_ic_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>