<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_rexmusic_widget"
    android:padding="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="▶  REXMUSIC  ·  NOW PLAYING"
                android:textColor="#8CBFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/widget_track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="RexMusic"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_track_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Pilih lagu untuk mulai"
                android:textColor="#C0CBDE"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="● PLAYER SIAP"
                android:textColor="#5FBEFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_lyrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="♪  Lirik akan muncul di sini"
                android:textColor="#E4EAF6"
                android:textSize="10sp"
                android:textStyle="italic" />

            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="7dp"
                android:progress="0"
                android:progressTint="#69B7FF"
                android:progressBackgroundTint="#354256" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_prev"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="|◀"
                    android:textColor="#EAF2FF"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/widget_play_pause"
                    android:layout_width="42dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_rexmusic_widget_play"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_next"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="▶|"
                    android:textColor="#EAF2FF"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp">

            <ImageView
                android:id="@+id/widget_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Album cover"
                android:scaleType="centerCrop"
                android:background="#202B40" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#33081220" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
