<?xml version="1.0" encoding="utf-8"?>
<!--
  RexMusic widget - EXTENDED (5x1, dipilih kode saat lebar >= WIDE_MIN_DP).
  Beda dengan compact: cover 50dp, label sumber panjang (ONLINE · STREAMING /
  OFFLINE · FILE LOKAL), dan satu baris lirik aktif. Tinggi tetap ~60dp.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rexw_bg"
    tools:ignore="HardcodedText,ContentDescription">

    <ImageView
        android:id="@+id/widget_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/rexw_tint"
        android:tint="#FF5B47E0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="5dp"
        android:paddingEnd="6dp"
        android:paddingBottom="5dp">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/rexw_cover_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="RexMusic"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_track_artist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Pilih lagu untuk mulai"
                    android:textColor="#B8FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.05"
                    android:maxLines="1"
                    android:text="● ONLINE · STREAMING"
                    android:textColor="#FF5FBEFF"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_lyrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="♪ Lirik tampil di sini"
                android:textColor="#FFCFC8FF"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:importantForAccessibility="no"
                android:max="1000"
                android:maxHeight="3dp"
                android:minHeight="3dp"
                android:progress="380"
                android:progressDrawable="@drawable/rexw_progress" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="40dp"
                android:layout_height="46dp"
                android:background="@drawable/rexw_btn_ghost"
                android:contentDescription="Lagu sebelumnya"
                android:paddingLeft="8dp"
                android:paddingTop="11dp"
                android:paddingRight="8dp"
                android:paddingBottom="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/rexw_ic_prev" />

            <ImageView
                android:id="@+id/widget_play_pause"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/rexw_btn_play"
                android:contentDescription="Putar"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/rexw_ic_play" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="40dp"
                android:layout_height="46dp"
                android:background="@drawable/rexw_btn_ghost"
                android:contentDescription="Lagu berikutnya"
                android:paddingLeft="8dp"
                android:paddingTop="11dp"
                android:paddingRight="8dp"
                android:paddingBottom="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/rexw_ic_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
