<?xml version="1.0" encoding="utf-8"?>
<!--
  RexMusic widget - EXTENDED (5x1, dipilih kode saat lebar >= WIDE_MIN_DP).
  ID wajib sama dengan widget_rexmusic_player.xml:
  widget_root, widget_bg, widget_cover, widget_track_title, widget_track_artist,
  widget_source, widget_lyrics, widget_progress, widget_time_current,
  widget_time_total, widget_prev, widget_play_pause, widget_next.
  Khusus wide: widget_lyrics_next.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rexw_bg"
    tools:ignore="HardcodedText,ContentDescription">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/rexw_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/rexw_cover_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="RexMusic"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_track_artist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Pilih lagu untuk mulai"
                    android:textColor="#C7FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/rexw_chip"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="2dp"
                    android:text="● ONLINE · STREAM"
                    android:textColor="#FF78C8FF"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- Lirik aktif (warna aksen diatur dari kode) -->
            <TextView
                android:id="@+id/widget_lyrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="♪"
                android:textColor="#FFA99BFF"
                android:textSize="12sp" />

            <!-- Lirik berikutnya -->
            <TextView
                android:id="@+id/widget_lyrics_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text=""
                android:textColor="#73FFFFFF"
                android:textSize="10sp" />

            <!-- Durasi kiri | progress | durasi kanan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_time_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="00:00"
                    android:textColor="#B3FFFFFF"
                    android:textSize="9sp" />

                <ProgressBar
                    android:id="@+id/widget_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:max="1000"
                    android:maxHeight="4dp"
                    android:minHeight="4dp"
                    android:progress="0"
                    android:progressDrawable="@drawable/rexw_progress" />

                <TextView
                    android:id="@+id/widget_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="00:00"
                    android:textColor="#B3FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Kontrol -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:contentDescription="Lagu sebelumnya"
                android:paddingStart="9dp"
                android:paddingTop="11dp"
                android:paddingEnd="9dp"
                android:paddingBottom="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/rexw_ic_prev" />

            <ImageView
                android:id="@+id/widget_play_pause"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/rexw_btn_play"
                android:contentDescription="Putar"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/rexw_ic_play" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:contentDescription="Lagu berikutnya"
                android:paddingStart="9dp"
                android:paddingTop="11dp"
                android:paddingEnd="9dp"
                android:paddingBottom="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/rexw_ic_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>