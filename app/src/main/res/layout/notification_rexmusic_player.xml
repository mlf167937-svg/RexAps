<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/rexmusic_notif_cover"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="RexMusic"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_media_play" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rexmusic_notif_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:maxLines="1"
                android:text="RexMusic"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rexmusic_notif_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Siap memutar"
                android:textColor="#B7BBC7"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/rexmusic_notif_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Tutup RexMusic"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </LinearLayout>

    <TextView
        android:id="@+id/rexmusic_notif_lyric"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="♪ Sedang diputar"
        android:textColor="#8AB4FF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/rexmusic_notif_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:max="1000"
        android:progress="0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rexmusic_notif_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="#8E93A1"
            android:textSize="10sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/rexmusic_notif_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="#8E93A1"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/rexmusic_notif_prev"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Sebelumnya"
            android:src="@android:drawable/ic_media_previous" />

        <ImageButton
            android:id="@+id/rexmusic_notif_play"
            android:layout_width="60dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Putar atau jeda"
            android:src="@android:drawable/ic_media_play" />

        <ImageButton
            android:id="@+id/rexmusic_notif_next"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Berikutnya"
            android:src="@android:drawable/ic_media_next" />
    </LinearLayout>
</LinearLayout>
