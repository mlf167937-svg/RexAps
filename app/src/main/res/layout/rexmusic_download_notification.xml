<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/download_notification_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rexmusic_download_surface_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/rexmusic_download_chip">

        <ImageView
            android:id="@+id/download_notification_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@string/rexmusic_download_icon_desc"
            android:src="@drawable/ic_rexmusic_download" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/download_notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/rexmusic_download_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/download_notification_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/rexmusic_download_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/download_notification_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/rexmusic_download_muted"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/download_notification_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="7dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#33404C5A"
            android:progressTint="@color/rexmusic_download_blue" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/download_notification_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rexmusic_download_chip"
                android:singleLine="true"
                android:textColor="@color/rexmusic_download_blue"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/download_notification_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/rexmusic_download_chip"
                android:singleLine="true"
                android:textColor="@color/rexmusic_download_blue"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- RemoteViews does not reliably support android.widget.Space on API 27.
                 Empty TextView is supported on Android 8.1 through current Android. -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"
                android:text="" />

            <TextView
                android:id="@+id/download_notification_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rexmusic_download_chip"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="@color/rexmusic_download_blue"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
